# Copy to .env and fill values. Never commit .env.

# Kaggle (local MCP orchestration)
KAGGLE_USERNAME=namdtgk14
KAGGLE_API_TOKEN=

# Weights & Biases
WANDB_API_KEY=
WANDB_ENTITY=namdotuan146-hanoi-university-of-science-and-technology
WANDB_PROJECT=semi-mask2former

# GitHub PAT (repo read / classic repo). Same name can be added as a Kaggle User Secret.
GITHUB_TOKEN=

# Google Drive — SA can read a shared folder; My Drive *uploads* need user OAuth
# (SA has no storage quota) OR a Shared Drive folder id.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=.secret/your-sa.json
GOOGLE_DRIVE_FOLDER_ID=
# Desktop OAuth client JSON, then: python -m aiaun_mcp.drive_login
# GOOGLE_DRIVE_OAUTH_CLIENT_JSON=.secret/gdrive-oauth-client.json
# GOOGLE_DRIVE_OAUTH_TOKEN_JSON=.secret/gdrive-token.json

# Owner mode: personal (default) or org
AIAUN_OWNER_MODE=personal
# KAGGLE_ORG=
# GITHUB_ORG=
# WANDB_TEAM=

# Optional: allow live acceptance tests
# AIAUN_LIVE_TEST=0
