# Copy to .env and fill values. Never commit .env / .env.* / envs/*.env.

# Per-codebase profiles (optional): copy this file to e.g. .env.data-engine-ssl
# and change WANDB_PROJECT (and any other keys). Pack with:
#   runtime_env_dataset_push(env_file=".env.data-engine-ssl")
# Host MCP still loads default .env for local Kaggle API auth.

# Kaggle (local MCP orchestration — host only; not packed into aiaun-run-env)
KAGGLE_USERNAME=namdtgk14
KAGGLE_API_TOKEN=

# Weights & Biases
WANDB_API_KEY=
WANDB_ENTITY=namdotuan146-hanoi-university-of-science-and-technology
WANDB_PROJECT=semi-mask2former

# GitHub fine-grained PAT: Repository access to the private repo(s) you clone,
# plus Repository permissions → Contents → Read-only (Metadata alone is not enough).
# Classic PAT: scope `repo`. Same name can be a Kaggle User Secret.
GITHUB_TOKEN=

# Google Drive — SA can read a shared folder; My Drive *uploads* need user OAuth
# (SA has no storage quota) OR a Shared Drive folder id.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=.secret/your-sa.json
GOOGLE_DRIVE_FOLDER_ID=
# Desktop OAuth client JSON, then: python -m aiaun_mcp.drive_login
# GOOGLE_DRIVE_OAUTH_CLIENT_JSON=.secret/gdrive-oauth-client.json
# GOOGLE_DRIVE_OAUTH_TOKEN_JSON=.secret/gdrive-token.json

# Owner mode: personal (default) or org
AIAUN_OWNER_MODE=personal
# KAGGLE_ORG=
# GITHUB_ORG=
# WANDB_TEAM=

# Optional: allow live acceptance tests
# AIAUN_LIVE_TEST=0
